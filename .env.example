# 이 파일을 .env 로 복사해서 씁니다. .env 는 절대 커밋하지 않습니다 (.gitignore).

# true 면 외부 호출 없이 픽스처로 구동됩니다. 키가 없어도 전 파이프라인이 돕니다.
MOCK_MODE=true

# ① Extractor 용. **두 벌입니다** (CLAUDE.md R7). 순서대로 시도하고,
#    둘 다 실패하면 MOCK_MODE 와 무관하게 휴리스틱으로 대체 구동됩니다.
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-sonnet-5
GPT_API_KEY=
GPT_MODEL=gpt-5.4-mini
# 비워 두는 것이 정상입니다. 기본값 claude,gpt.
# 한쪽 잔액이 0 인 동안만 장애 우회로 순서를 뒤집고, 복구되면 다시 비웁니다.
EXTRACTOR_ORDER=

# ② SafetyKorea Open API.
# 호스트는 설계서 v2.0 의 고정값이라 kats_field_map.yaml 에 들어 있습니다.
# KATS_BASE_URL 은 비워두세요 — 시험용 오버라이드가 필요할 때만 씁니다.
KATS_BASE_URL=

# 인증키만 있으면 실연동이 시작됩니다 (없으면 목 모드로 남습니다).
# 2026-09-01 수령. 회신에 "IP 제한은 없습니다" 가 명시되어 IP 등록은 불필요합니다.
# 이 값을 커밋·로그에 남기지 마세요 (.env 는 .gitignore 대상).
KATS_SERVICE_KEY=

# 워치리스트 SQLite 경로. 배포 시 반드시 영구 볼륨을 가리키게 하세요.
# 컨테이너 기본 파일시스템에 두면 재배포마다 등록 상품이 사라집니다 (기획서 §6.1).
WATCHLIST_DB_PATH=data/watchlist.db

# 리콜 로컬 동기화. 기본값은 "MOCK_MODE 가 false 이면 켬" 입니다.
# 투표 기간에 공개 트래픽이 정부 API 를 직접 때리지 않게 하는 장치입니다.
SYNC_ENABLED=

# POST /api/v1/sync 수동 트리거용 토큰. 비워두면 엔드포인트가 403 을 돌려줍니다.
# 데모 직전 강제 최신화나 문제 발생 시 로그를 보며 돌릴 때 씁니다.
# HTTP 헤더로 보내므로 ASCII 만 씁니다 (한글을 넣으면 클라이언트가 인코딩에 실패합니다).
SYNC_TOKEN=

# ⑤ 도매꾹 Open API (상품·카테고리 조회). 표본 수집용이고 **배포본은 부르지
#    않습니다** - 도매꾹이 호출 IP 를 등록받으므로 고정 egress IP 확정 전까지
#    scripts/ 안에서만 씁니다. 401/403 이면 IP 변경부터 의심하세요.
#    쿼터: 분당 180회 · 하루 15,000회 (초과 시 429 자동차단).
DOMEGGOOK_API_KEY=
